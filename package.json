{
  "name": "@muradmadi/brand",
  "version": "1.1.0",
  "description": "Murad Madi's brand: Tailwind v4 theme, CSS variables, logos, icons, social banners, fonts, profile and email signature",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://muradmadi.github.io/brand/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muradmadi/brand.git"
  },
  "type": "module",
  "files": [
    "dist",
    "logos",
    "fonts"
  ],
  "exports": {
    "./theme.css": "./dist/theme.css",
    "./variables.css": "./dist/variables.css",
    "./fonts.css": "./dist/fonts.css",
    "./profile.json": "./dist/profile.json",
    "./logos/*": "./logos/*",
    "./icons/*": "./dist/icons/*",
    "./social/*": "./dist/social/*",
    "./email/*": "./dist/email/*",
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0"
  },
  "peerDependencies": {
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "latest",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7"
  }
}
